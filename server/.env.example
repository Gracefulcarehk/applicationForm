# Copy to .env for local development. In production set these in the hosting
# provider's environment settings; never commit real values.

PORT=5003
# Number of reverse proxies in front of the server (1 on most hosts, 0 when run directly)
TRUST_PROXY=1

# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gracefulcare?retryWrites=true&w=majority

# Comma-separated origins allowed to submit applications
CORS_ORIGINS=http://localhost:3000

# Cloudflare R2 (private bucket). Create an R2 API token with Object Read & Write on this bucket only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=gracefulcare-applications

# Gmail SMTP: SMTP_USER is the Gmail address, SMTP_PASS a Google App Password (requires 2-Step Verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=gracefulcarehk@gmail.com
SMTP_PASS=
# Internal mailbox that receives new application notifications (with full details and attachments)
NOTIFY_TO=
